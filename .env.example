# Finance PWA — Environment Variables
#
# Hybrid API mode:
#   - When VITE_API_HOST is set, the app calls the real backend.
#   - When unset (or empty), all services fall back to in-memory mocks.
#   - VITE_FORCE_MOCK=true keeps mocks active even if VITE_API_HOST is set.

VITE_API_HOST=
VITE_FORCE_MOCK=
