# Finance PWA — Environment Variables
#
# Hybrid API mode:
#   - When NEXT_PUBLIC_API_HOST is set, the app calls the real backend.
#   - When unset (or empty), all services fall back to in-memory mocks.
#   - NEXT_PUBLIC_FORCE_MOCK=true keeps mocks active even if NEXT_PUBLIC_API_HOST is set.

NEXT_PUBLIC_API_HOST=
NEXT_PUBLIC_FORCE_MOCK=

# PRODUCTION: set NEXT_PUBLIC_API_HOST to the real backend and leave
# NEXT_PUBLIC_FORCE_MOCK empty. With mocks disabled the build physically excludes
# the mock adapter (seed users + demo credentials). Deploy pipelines (CI=1 or
# PROD_BUILD=1) will REFUSE to build if mocks are still enabled.
