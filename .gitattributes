# Normalize line endings to LF on commit, convert to CRLF on Windows checkout
* text=auto

# Web source files — always LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf

# Config files — always LF
.gitignore      text eol=lf
.gitattributes  text eol=lf
*.config.js     text eol=lf
*.config.ts     text eol=lf

# Binary files — no conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
